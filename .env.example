# Mesmo projeto Supabase compartilhado com inq-saas e ink-system-plataforma.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Segredo servidor-a-servidor deste projeto -- dedicado, nunca reaproveita
# PROVISIONING_SERVICE_SECRET nem INTERNAL_SERVICE_SECRET (de outros
# projetos). Enviado no header X-Implementacoes-Service-Key.
IMPLEMENTACOES_SERVICE_SECRET=

# Cofre BYOK. Gerar 32 bytes aleatórios em base64 e preservar o valor.
INTEGRACOES_ENCRYPTION_KEY=

# Conta central exclusiva do proprietário (CRM P&D + painel administrativo).
ZENVIA_API_KEY=
ZENVIA_FROM=

# Meta WhatsApp (Embedded Signup) -- só servidor, nunca NEXT_PUBLIC_.
# META_APP_SECRET é segredo. META_GRAPH_VERSION no formato vNN.N (ex.: v26.0).
# META_WHATSAPP_USUARIOS_PERMITIDOS: user_ids do laboratório, separados por
# vírgula; vazio = ninguém habilitado.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_WHATSAPP_USUARIOS_PERMITIDOS=
# Webhook (Fase 3): texto aleatório (32+ caracteres), o MESMO valor digitado
# no painel da Meta ao cadastrar o webhook. A assinatura dos eventos usa o
# META_APP_SECRET acima.
META_WEBHOOK_VERIFY_TOKEN=
